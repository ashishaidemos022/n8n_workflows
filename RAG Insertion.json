    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    fullDocument: $input.first().json.text,\n    fileName: $input.first().binary?.file?.fileName ?? 'document.pdf'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -32
      ],
      "id": "617dd6bc-9c20-4c7c-a33e-6ec8a6106a74",
      "name": "Stash document"
    },
    {
      "parameters": {
        "jsCode": "const fullText = $json.fullDocument;\nconst fileName = $json.fileName;\nconst chunkSize = 3200;   // ~800 tokens\nconst overlap = 400;       // ~100 tokens\n\nconst chunks = [];\nfor (let i = 0; i < fullText.length; i += (chunkSize - overlap)) {\n  const piece = fullText.slice(i, i + chunkSize);\n  if (piece.trim().length < 100) continue;  // skip tiny tail chunks\n  chunks.push({\n    json: {\n      chunkIndex: chunks.length,\n      chunkContent: piece,\n      fullDocument: fullText,\n      fileName: fileName\n    }\n  });\n}\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        -32
      ],
      "id": "3340fb57-fad6-4d64-b69c-dd1eda9910e5",
      "name": "Chunks"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 200,\n  \"system\": \"You produce a 1-2 sentence context for a chunk of text within a larger document, to improve search retrieval. Output ONLY the context. No preamble, no quotes, no commentary.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": {{ JSON.stringify(\"<document>\\n\" + $json.fullDocument + \"\\n</document>\") }},\n          \"cache_control\": {\"type\": \"ephemeral\"}\n        },\n        {\n          \"type\": \"text\",\n          \"text\": {{ JSON.stringify(\"Here is the chunk we want to situate within the document:\\n<chunk>\\n\" + $json.chunkContent + \"\\n</chunk>\\n\\nGive a 1-2 sentence context for this chunk to improve retrieval. Output ONLY the context.\") }}\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        656,
        -32
      ],
      "id": "955b1dd4-5941-444d-8273-9e21ea63a4bf",
      "name": "Generate context (Claude)",
      "credentials": {
        "anthropicApi": {
          "id": "BsoMez4BNwa17pY1",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const contexts = $input.all();              // 12 Claude responses\nconst chunks = $('Chunks').all();            // 12 original chunks\n\nreturn contexts.map((item, i) => {\n  const ctx = item.json.content[0].text.trim();\n  const chunkRef = chunks[i].json;\n\n  return {\n    json: {\n      content: chunkRef.chunkContent,\n      contextualized_content: `${ctx}\\n\\n${chunkRef.chunkContent}`,\n      metadata: {\n        file_name: chunkRef.fileName,\n        chunk_index: chunkRef.chunkIndex\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -32
      ],
      "id": "6152de82-aa3f-46fb-8ab8-6fd47eee7d91",
      "name": "Combine chunk + context"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.voyageai.com/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": [{{ JSON.stringify($json.contextualized_content) }}],\n  \"model\": \"voyage-3-large\",\n  \"output_dimension\": 1024,\n  \"input_type\": \"document\"\n}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 25000
            }
          }
        }
      },
