    {
      "parameters": {
        "jsCode": "const voyageItems = $input.all();           // 12 Voyage responses\nconst refs = $('Combine chunk + context').all();  // 12 paired chunks\n\nreturn voyageItems.map((item, i) => {\n  const embedding = item.json.data[0].embedding;\n  const ref = refs[i].json;\n\n  return {\n    json: {\n      content: ref.content,\n      contextualized_content: ref.contextualized_content,\n      metadata: ref.metadata,\n      embedding_str: `[${embedding.join(',')}]`\n    }\n  };\n});"
      },
